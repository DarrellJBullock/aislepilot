# AislePilot environment
# All values are OPTIONAL for local development. With none set, the app runs in
# full MOCK MODE (local in-memory data + MockKrogerProvider) — no accounts needed.

# Supabase (optional — enables real auth + persistence)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Kroger API (optional — server-only, enables live retailer data)
KROGER_CLIENT_ID=
KROGER_CLIENT_SECRET=
KROGER_BASE_URL=https://api.kroger.com/v1

# Force mock retailer data even if Kroger creds are present
USE_MOCK_RETAILER_DATA=true
