{
  "expo": {
    "name": "AislePilot",
    "slug": "aislepilot",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "aislepilot",
    "userInterfaceStyle": "light",
    "backgroundColor": "#f7f8fa",
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#f7f8fa",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "AislePilot uses the camera to scan product barcodes while shopping."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "AislePilot uses your location to find nearby stores."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#f7f8fa",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "bundleIdentifier": "com.anonymous.aislepilot"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "8f37307b-31d0-41fe-ba72-d268cd552517"
      }
    },
    "owner": "djb215"
  }
}
